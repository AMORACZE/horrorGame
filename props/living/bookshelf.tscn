[node name="Interactable" type="Node" parent="."]
script = ExtResource("8_interactable")
display_name = "Bookshelf"
observations = Array[String](["Paperbacks, a road atlas, a medical guide. One book is back on the shelf upside down.", "A gap on the second shelf, two books wide. The dust stops at the edges of it.", "The spines on the top shelf have faded where the afternoon sun reaches them."])
