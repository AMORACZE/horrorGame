class_name OsdFont
extends RefCounted
## Original 5x7 blocky character set for the camcorder on-screen display,
## drawn as rectangles (no font file needed). Each glyph is 7 rows of 5 columns;
## '#' is a lit pixel. Glyph advance is 6 cells (5 + 1 spacing).

const W := 5
const H := 7
const ADVANCE := 6

const GLYPHS := {
	"0": [".###.", "##.##", "##.##", "##.##", "##.##", "##.##", ".###."],
