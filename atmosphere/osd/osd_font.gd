## Battery outline, 11 x 7, with three 2-cell bars filled from the left.
const BATTERY := [
	"##########.",
	"#........#.",
	"#........##",
	"#........##",
	"#........##",
	"#........#.",
	"##########.",
]


static func text_width(text: String) -> int:
	if text.is_empty():
		return 0
	return text.length() * ADVANCE - 1


## Draws `text` with its top-left at `origin` (pixels), `scale` pixels per cell,
## and a dark edge `edge` pixels wide, like a character generator keyed over video.
static func draw_text(ci: CanvasItem, origin: Vector2, text: String, scale: float,
		color: Color, edge_color: Color, edge: float) -> void:
	var x := origin.x
	for ch: String in text:
		var rows: Array = GLYPHS.get(ch, GLYPHS[" "])
		draw_cells(ci, Vector2(x, origin.y), rows, scale, color, edge_color, edge)
		x += ADVANCE * scale


static func draw_cells(ci: CanvasItem, origin: Vector2, rows: Array, scale: float,
		color: Color, edge_color: Color, edge: float) -> void:
	if edge > 0.0:
		_draw_cells_pass(ci, origin, rows, scale, edge_color, edge)
	_draw_cells_pass(ci, origin, rows, scale, color, 0.0)


static func _draw_cells_pass(ci: CanvasItem, origin: Vector2, rows: Array, scale: float,
		color: Color, grow: float) -> void:
	for y: int in rows.size():
		var row: String = rows[y]
		var x := 0
		while x < row.length():
			if row[x] != "#":
				x += 1
				continue
			# Merge horizontal runs into one rect.
			var run := 1
			while x + run < row.length() and row[x + run] == "#":
				run += 1
			ci.draw_rect(Rect2(origin.x + x * scale - grow, origin.y + y * scale - grow,
					run * scale + grow * 2.0, scale + grow * 2.0), color)
			x += run
