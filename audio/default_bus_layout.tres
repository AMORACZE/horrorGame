[gd_resource type="AudioBusLayout" load_steps=10 format=3]

[sub_resource type="AudioEffectHardLimiter" id="AudioEffectHardLimiter_master"]
resource_name = "SafetyLimiter"
ceiling_db = -1.0
release = 0.12

[sub_resource type="AudioEffectReverb" id="AudioEffectReverb_room"]
resource_name = "RoomReverb"
predelay_msec = 10.0
predelay_feedback = 0.1
room_size = 0.32
damping = 0.72
spread = 0.6
hipass = 0.12
dry = 1.0
wet = 0.09

[sub_resource type="AudioEffectHighPassFilter" id="AudioEffectHighPassFilter_mic"]
resource_name = "CamMicLowCut"
cutoff_hz = 80.0
resonance = 0.5

[sub_resource type="AudioEffectLowPassFilter" id="AudioEffectLowPassFilter_mic"]
resource_name = "CamMicTop"
cutoff_hz = 12000.0
resonance = 0.5

[sub_resource type="AudioEffectEQ6" id="AudioEffectEQ6_mic"]
