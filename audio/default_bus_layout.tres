band_db/32_hz = -2.0
band_db/100_hz = 0.0
band_db/320_hz = 0.0
band_db/1000_hz = 0.5
band_db/3200_hz = 1.0
band_db/10000_hz = -1.5

[sub_resource type="AudioEffectCompressor" id="AudioEffectCompressor_agc"]
resource_name = "CamAGC"
threshold = -22.0
ratio = 2.0
gain = 1.5
attack_us = 8000.0
release_ms = 450.0
mix = 1.0

[sub_resource type="AudioEffectHighPassFilter" id="AudioEffectHighPassFilter_amb"]
resource_name = "CamMicLowCut"
cutoff_hz = 70.0
resonance = 0.5

[sub_resource type="AudioEffectLowPassFilter" id="AudioEffectLowPassFilter_amb"]
resource_name = "CamMicTop"
cutoff_hz = 12500.0
resonance = 0.5

[sub_resource type="AudioEffectCompressor" id="AudioEffectCompressor_footsteps"]
resource_name = "FootstepGlue"
threshold = -16.0
ratio = 2.0
attack_us = 1500.0
release_ms = 120.0
mix = 1.0

